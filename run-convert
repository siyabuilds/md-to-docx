#!/usr/bin/env bash
set -euo pipefail

TARGET_DIR="${1:-.}"

if ! command -v pandoc >/dev/null 2>&1; then
  echo "Error: pandoc is required but was not found in PATH." >&2
  exit 1
fi

if [[ ! -d "$TARGET_DIR" ]]; then
  echo "Error: '$TARGET_DIR' is not a directory." >&2
  exit 1
fi

WORD_DIR="$TARGET_DIR/word"
mkdir -p "$WORD_DIR"

found=0
while IFS= read -r -d '' md_file; do
  found=1
  base_name=$(basename "$md_file")
  dir_name=$(dirname "$md_file")
  
  if [[ "${base_name,,}" == "index.md" || "${base_name,,}" == "_index.md" ]]; then
    parent_folder=$(basename "$(realpath "$dir_name")")
    out_name="${parent_folder}.docx"
  else
    out_name="${base_name%.*}.docx"
  fi
  
  output_file="$WORD_DIR/$out_name"
  
  if ! pandoc "$md_file" -o "$output_file" -V mainfont="Poppins"; then
    echo "Error: failed to convert '$md_file'." >&2
    exit 1
  fi
  echo "Converted: $md_file -> $output_file"
done < <(find "$TARGET_DIR" -type f \( -iname "*.md" -o -iname "*.markdown" \) -print0)

if [[ "$found" -eq 0 ]]; then
  echo "No markdown files found in '$TARGET_DIR'."
fi
